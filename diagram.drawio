        <mxCell id="g0" value="베이스 ActorBehaviorTree.BuildTree() — 모든 액터 공통" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="560" height="190" as="geometry" /></mxCell>
        <mxCell id="b_sel" value="? Selector" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="84" width="120" height="50" as="geometry" /></mxCell>
        <mxCell id="b_seq" value="→ Sequence (Stun 처리)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="b_hook" value="BuildPrimary() ⟨virtual hook⟩" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="170" width="200" height="50" as="geometry" /></mxCell>
