<mxfile host="app.diagrams.net" type="device">
  <diagram name="1. 3계층 아키텍처" id="arch3">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Actor 행동·연출 3계층 (이음새 = ActorState)" style="text;html=1;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="560" height="30" as="geometry" /></mxCell>
        <mxCell id="lb1" value="두뇌" style="text;html=1;align=center;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="60" height="80" as="geometry" /></mxCell>
        <mxCell id="brain" value="ActorBehaviorTree (MonoBehaviour, 액터당 1개)&lt;br&gt;· BuildTree() → Update에서 tick&lt;br&gt;· 리프가 결정&lt;br&gt;&lt;b&gt;· ActorState의 유일한 writer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="poco" value="POCO 로직 (기존·검증됨)&lt;br&gt;PathFollowerLogic&lt;br&gt;ArenaOrbitLogic&lt;br&gt;CombatLogic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="540" y="70" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="e_bp" value="🅰 리프 호출 (결정→계산)" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="brain" target="poco"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lb2" value="이음새" style="text;html=1;align=center;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="60" height="80" as="geometry" /></mxCell>
        <mxCell id="state" value="ActorState  (ActorBase 소유, 기존 코드 재사용)&lt;br&gt;SetState() → StateChanged 이벤트 발행&lt;br&gt;값: Idle / Moving / Attacking / Stunned / Dead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="120" y="210" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="e_bs" value="actor.SetState(...)" style="endArrow=block;html=1;fontStyle=1;" edge="1" parent="1" source="brain" target="state"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lb3" value="연출" style="text;html=1;align=center;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="60" height="80" as="geometry" /></mxCell>
        <mxCell id="view" value="ActorAnimatorBinder  (StateChanged 구독)&lt;br&gt;· Animator 파라미터만 push&lt;br&gt;· State(int) + Direction(int)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="120" y="350" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="e_sv" value="StateChanged.Invoke(newState)" style="endArrow=block;html=1;" edge="1" parent="1" source="state" target="view"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctrl" value="AnimatorController 에셋&lt;br&gt;· 전환 규칙 소유&lt;br&gt;&lt;b&gt;· 프리팹별 교체 = 애니 오버라이드 (코드 0)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="120" y="490" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="e_vc" value="SetInteger(State) / SetInteger(Direction)" style="endArrow=block;html=1;" edge="1" parent="1" source="view" target="ctrl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note1" value="핵심: 화살표는 한 방향(위→아래).&#10;BT만 상태를 쓰고, View는 읽기만 한다.&#10;→ 같은 프레임 상태 경쟁 없음 (TASK-006 재발 방지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="540" y="350" width="300" height="80" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
